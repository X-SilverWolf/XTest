# Use the Qt SDK for this target's compiler and keep its imports local to this GUI.
set(CMAKE_FIND_PACKAGE_TARGETS_GLOBAL OFF)
set(QT_PROMOTE_TO_GLOBAL_TARGETS OFF)
set(X_QT_PREFIX "" CACHE PATH "Qt 6.10.2 SDK built for this toolchain")
if(X_QT_PREFIX)
    file(GLOB qt_configs "${X_QT_PREFIX}/lib/cmake/Qt6*/Qt6*Config.cmake")
    foreach(config IN LISTS qt_configs)
        cmake_path(GET config STEM config_name)
        string(REGEX REPLACE "Config$" "" component "${config_name}")
        cmake_path(GET config PARENT_PATH "${component}_DIR")
    endforeach()
    set(Qt6_DIR "${X_QT_PREFIX}/lib/cmake/Qt6")
endif()
find_package(Qt6 6.10.2 EXACT CONFIG REQUIRED COMPONENTS Widgets)
